{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Android app",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [":app:assembleDebug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [":app:testDebugUnitTest"],
      "problemMatcher": []
    },
    {
      "label": "Install on Android device or emulator",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [":app:installDebug"],
      "problemMatcher": []
    }
  ]
}
